# Copy to .env and fill in. .env is gitignored; never commit real keys.

# Claude API (https://console.anthropic.com)
ANTHROPIC_API_KEY=your-anthropic-api-key
# Optional overrides
AGENT_MODEL=claude-opus-5
JUDGE_MODEL=claude-opus-5

# SerpApi Google Flights engine (https://serpapi.com) - free tier ~100 searches/month
SERPAPI_API_KEY=your-serpapi-key

# Fare tracker email alerts (Gmail). Create an app password at
# https://myaccount.google.com/apppasswords (requires 2-Step Verification).
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
# Optional: send alerts somewhere other than GMAIL_ADDRESS
ALERT_TO=

# Langfuse observability (https://cloud.langfuse.com) - leave blank to disable tracing
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com
